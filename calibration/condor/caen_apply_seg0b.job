Universe           = vanilla
initialDir         = /sphenix/user/tmengel/eic/bic_testbeam/calibration/condor
Executable         = $(initialDir)/caen_apply.sh
Arguments          = 0
PeriodicHold       = (NumJobStarts>=1 && JobStatus == 1)
concurrency_limits = CONCURRENCY_LIMIT_DEFAULT:1000
request_memory     = 6GB
Priority           = 20
Output             = /sphenix/user/tmengel/eic/output/root_logs/caen_apply_0b.out
Error              = /sphenix/user/tmengel/eic/output/root_logs/caen_apply_0b.err
Log                = /tmp/condor-caen_apply-$ENV(USER).log
Queue 1
