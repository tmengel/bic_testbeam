Universe           = vanilla
initialDir         = /sphenix/user/tmengel/eic/bic_testbeam/calibration/condor
Executable         = $(initialDir)/run_stability.sh
Arguments          = $(board) $(tag) 45000
PeriodicHold       = (NumJobStarts>=1 && JobStatus == 1)
concurrency_limits = CONCURRENCY_LIMIT_DEFAULT:1000
request_memory     = 2GB
Priority           = 20
Output             = /sphenix/user/tmengel/eic/output/root_logs/stab_$(board)_$(tag).out
Error              = /sphenix/user/tmengel/eic/output/root_logs/stab_$(board)_$(tag).err
Log                = /tmp/condor-run_stability-$ENV(USER).log
Queue board, tag from $(list)
