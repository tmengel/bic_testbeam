Universe           = vanilla
initialDir         = /sphenix/user/tmengel/eic/bic_testbeam/sim/condor
Executable         = $(initialDir)/scan.sh
Arguments          = $(energy) $(nevents) $(seed) 30 $(yoff)
PeriodicHold       = (NumJobStarts>=1 && JobStatus == 1)
concurrency_limits = CONCURRENCY_LIMIT_DEFAULT:1000
request_memory     = 2GB
Priority           = 20
Output             = /sphenix/user/tmengel/eic/bic_testbeam/sim/condor/logs/scan_e$(energy)_bby$(yoff)_s$(seed).out
Error              = /sphenix/user/tmengel/eic/bic_testbeam/sim/condor/logs/scan_e$(energy)_bby$(yoff)_s$(seed).err
Log                = /tmp/condor-bic_sim-$ENV(USER)-bby-$(seed).log
Queue energy, nevents, seed, yoff from (
  4000 5000 51 -25
  4000 5000 52 -12.5
  4000 5000 53 12.5
  4000 5000 54 25
  4000 5000 55 -37.5
  4000 5000 56 37.5
  3000 5000 57 -12.5
  5000 5000 58 -12.5
  6000 5000 59 -12.5
  3000 5000 60 12.5
  5000 5000 61 12.5
  6000 5000 62 12.5
)
