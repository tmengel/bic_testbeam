# cosmic target mode: every muon passes through one of the four trigger paddles as placed (flux-correct face sampling, /bic/gun/cosmicTarget 1),
# the population the paddle-triggered run 3088 selects (near-horizontal tracks, zenith ~72 deg, that cross a paddle and the stack); 100 x 100k, output sim/cosmic/tgt/
Universe           = vanilla
initialDir         = /sphenix/user/tmengel/eic/bic_testbeam/sim/condor
Executable         = $(initialDir)/cosmic.sh
Arguments          = 100000 $(seed) tgt
environment        = "EXTRA='/bic/gun/cosmicTarget 1'"
PeriodicHold       = (NumJobStarts>=1 && JobStatus == 1)
concurrency_limits = CONCURRENCY_LIMIT_DEFAULT:1000
request_memory     = 2GB
Priority           = 20
Output             = /sphenix/user/tmengel/eic/bic_testbeam/sim/condor/logs/cosmic_tgt_s$(seed).out
Error              = /sphenix/user/tmengel/eic/bic_testbeam/sim/condor/logs/cosmic_tgt_s$(seed).err
Log                = /tmp/condor-bic_cosmic-$ENV(USER).log
Queue seed from seq 301 400 |
