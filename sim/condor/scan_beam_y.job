Universe           = vanilla
initialDir         = /sphenix/user/tmengel/eic/bic_testbeam/sim/condor
Executable         = $(initialDir)/scan.sh
Arguments          = $(energy) $(nevents) $(seed) 30 0 $(ybeam)
PeriodicHold       = (NumJobStarts>=1 && JobStatus == 1)
concurrency_limits = CONCURRENCY_LIMIT_DEFAULT:1000
request_memory     = 2GB
Priority           = 20
Output             = /sphenix/user/tmengel/eic/bic_testbeam/sim/condor/logs/scan_e$(energy)_yb$(ybeam)_s$(seed).out
Error              = /sphenix/user/tmengel/eic/bic_testbeam/sim/condor/logs/scan_e$(energy)_yb$(ybeam)_s$(seed).err
Log                = /tmp/condor-bic_sim-$ENV(USER)-yb-$(seed).log
Queue energy, nevents, seed, ybeam from (
  4000 5000 71 -14
  4000 5000 72 -9.5
  4000 5000 73 -2
  4000 5000 74 0
  4000 5000 75 2
)
