Universe           = vanilla
initialDir         = /sphenix/user/tmengel/eic/bic_testbeam/waveforms/condor
Executable         = $(initialDir)/run_fit.sh
Arguments          = $(board) $(tag) $(tpl)
PeriodicHold       = (NumJobStarts>=1 && JobStatus == 1)
concurrency_limits = CONCURRENCY_LIMIT_DEFAULT:1000
request_memory     = 3GB
Priority           = 20
Output             = /sphenix/user/tmengel/eic/output/root_logs/fit_$(board)_$(tag).out
Error              = /sphenix/user/tmengel/eic/output/root_logs/fit_$(board)_$(tag).err
Log                = /tmp/condor-run_fit-$ENV(USER).log
Queue board, tag, tpl from $(list)
