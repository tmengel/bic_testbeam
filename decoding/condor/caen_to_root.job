Universe           = vanilla
initialDir         = /sphenix/user/tmengel/eic/bic_testbeam/decoding/condor
Executable         = $(initialDir)/caen_to_root.sh
Arguments          = $(seg)
PeriodicHold       = (NumJobStarts>=1 && JobStatus == 1)
concurrency_limits = CONCURRENCY_LIMIT_DEFAULT:1000
request_memory     = 2GB
Priority           = 20
Output             = /sphenix/user/tmengel/eic/output/root_logs/caen_to_root_seg$(seg).out
Error              = /sphenix/user/tmengel/eic/output/root_logs/caen_to_root_seg$(seg).err
Log                = /tmp/condor-caen_to_root-$ENV(USER)-$(seg).log
Queue seg in (0 1 2)
